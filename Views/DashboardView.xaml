<UserControl x:Class="STOMS_SBV1_BOS_IME.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:STOMS_SBV1_BOS_IME.Models"
             xmlns:converters="clr-namespace:STOMS_SBV1_BOS_IME.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1200">
    <Grid>
        <!-- Main Scrollable Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,32">

                <!-- Data Origin & Telemetry Banner -->
                <Border Background="{DynamicResource Theme.Surface.CardAlt}" 
                        BorderBrush="{DynamicResource Theme.Border}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14,10" 
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pulse Status Indicator -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrandAccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="SYSTEM TELEMETRY:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Summary.DataOriginDescription}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                        </StackPanel>

                        <!-- Refresh & Timestamp -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary.LastRefreshed, StringFormat='Synced: {0:HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding RefreshCommand}" 
                                    Padding="10,4" 
                                    ToolTip="Refresh live telemetry from warehouse engine">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Refresh}" Fill="{DynamicResource Theme.Text.Primary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Sync Ledger" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error Banner if any -->
                <Border Background="#33EF4444" 
                        BorderBrush="{StaticResource DangerBrush}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12" 
                        Margin="0,0,0,16" 
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Alert}" Fill="{StaticResource DangerBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 1: INVENTORY SUMMARY CARDS (6 CARDS) -->
                <TextBlock Text="KEY INVENTORY TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}" Margin="2,0,0,8"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Total Products -->
                    <Border Grid.Column="0" Style="{StaticResource IndustrialCard}" Margin="0,0,8,0">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding FilterByStatusCardCommand}" CommandParameter="totalproducts">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Total Products" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource Icon.Products}" Fill="{StaticResource BrandAccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Summary.TotalProducts, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="Distinct SKU records" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Card 2: Total Stock Quantity -->
                    <Border Grid.Column="1" Style="{StaticResource IndustrialCard}" Margin="4,0,4,0">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding FilterByStatusCardCommand}" CommandParameter="totalquantity">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Stock Quantity" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource Icon.Stock}" Fill="{StaticResource BrandPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Summary.TotalStockQuantity, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Summary.PrimaryUnit, StringFormat='Unit aware: {0}'}" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Card 3: Low Stock Items -->
                    <Border Grid.Column="2" Style="{StaticResource IndustrialCard}" Margin="4,0,4,0">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding FilterByStatusCardCommand}" CommandParameter="lowstock">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Low Stock" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource Icon.LowStock}" Fill="{StaticResource WarningBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Summary.LowStockItemsCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="At/below threshold" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Card 4: Near Expiry -->
                    <Border Grid.Column="3" Style="{StaticResource IndustrialCard}" Margin="4,0,4,0">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding FilterByStatusCardCommand}" CommandParameter="nearexpiry">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Near Expiry" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource Icon.Expiry}" Fill="#EA580C" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Summary.NearExpiryBatchesCount}" FontSize="24" FontWeight="Bold" Foreground="#EA580C" Margin="0,0,0,4"/>
                                <TextBlock Text="Expiring ≤ 30 days" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Card 5: Expired Stock -->
                    <Border Grid.Column="4" Style="{StaticResource IndustrialCard}" Margin="4,0,4,0">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding FilterByStatusCardCommand}" CommandParameter="expired">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Expired Stock" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource Icon.Expired}" Fill="{StaticResource DangerBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Summary.ExpiredStockBatchesCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Quarantine required" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Card 6: Pending Approvals -->
                    <Border Grid.Column="5" Style="{StaticResource IndustrialCard}" Margin="8,0,0,0">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding FilterByStatusCardCommand}" CommandParameter="pendingapprovals">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Pending Approvals" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource Icon.Approvals}" Fill="{StaticResource InfoBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Summary.PendingApprovalsCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Awaiting sign-off" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>

                <!-- SECTION 2: QUICK ACTIONS TOOLBAR -->
                <TextBlock Text="RAPID WAREHOUSE OPERATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}" Margin="2,0,0,8"/>
                <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,24" Padding="12,10">
                    <WrapPanel Orientation="Horizontal">
                        <!-- Receive Stock -->
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,4,10,4" Command="{Binding ReceiveStockActionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Inward}" Fill="{StaticResource SuccessBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Receive Stock (Inward)" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Issue Stock -->
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,4,10,4" Command="{Binding IssueStockActionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Outward}" Fill="{StaticResource DangerBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Issue Stock (Outward)" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Transfer Stock -->
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,4,10,4" Command="{Binding TransferStockActionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Transfer}" Fill="{StaticResource BrandAccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Transfer Stock" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Add Product -->
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,4,10,4" Command="{Binding AddProductActionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Products}" Fill="{DynamicResource Theme.Text.Primary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Add Product (SKU)" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- View Warehouse -->
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,4,10,4" Command="{Binding ViewWarehouseActionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Warehouse}" Fill="{DynamicResource Theme.Text.Primary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Warehouse Topology" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Review Approvals -->
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,4,0,4" Command="{Binding ReviewApprovalsActionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Approvals}" Fill="{StaticResource InfoBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Review Pending Sign-Offs" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- SECTION 3: WAREHOUSE & RACK VISUALIZATION (CORE FEATURE) -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="WAREHOUSE RACK TOPOLOGY &amp; BIN VISUALIZATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}" VerticalAlignment="Center"/>

                    <!-- Filter Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Warehouse Selector -->
                        <ComboBox Width="200" 
                                  ItemsSource="{Binding Warehouses}" 
                                  SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay}" 
                                  DisplayMemberPath="Name" 
                                  Style="{StaticResource ModernComboBox}" 
                                  Margin="0,0,8,0"
                                  ToolTip="Filter racks by specific warehouse facility"/>

                        <!-- Search SKU / Rack -->
                        <TextBox Width="180" 
                                 Text="{Binding RackSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}" 
                                 Margin="0,0,8,0"
                                 ToolTip="Search rack code, section, or product SKU"/>

                        <!-- Reset Filters -->
                        <Button Style="{StaticResource SecondaryButton}" 
                                Command="{Binding ResetFiltersCommand}" 
                                Padding="8,4" 
                                ToolTip="Reset warehouse &amp; rack filters"
                                Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Filter}" Fill="{DynamicResource Theme.Text.Primary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Text="Clear Filter" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Rack Visualization Split View -->
                <Grid Margin="0,0,0,24" MinHeight="360">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Rack Vertical Structures List -->
                    <Border Grid.Column="0" Style="{StaticResource IndustrialCard}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="RACKS &amp; STORAGE BAYS" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.Text.Muted}" Margin="4,0,0,8"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Racks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:Rack}">
                                            <Border Margin="0,0,0,8" 
                                                    Background="{DynamicResource Theme.Surface.CardAlt}" 
                                                    BorderBrush="{DynamicResource Theme.Border}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Rack Header Card -->
                                                    <Button Grid.Row="0" 
                                                            Background="Transparent" 
                                                            BorderThickness="0" 
                                                            Padding="12,10" 
                                                            Cursor="Hand"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.ToggleRackExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Steel Rack Icon / Level indicator -->
                                                            <Border Grid.Column="0" 
                                                                    Width="36" Height="36" 
                                                                    Background="{DynamicResource Theme.Rack.SteelFrame}" 
                                                                    CornerRadius="4" 
                                                                    Margin="0,0,10,0">
                                                                <Path Data="{StaticResource Icon.Warehouse}" Fill="{DynamicResource Theme.Text.Primary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Rack Info -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding RackCode}" FontWeight="Bold" FontSize="13" Margin="0,0,8,0"/>
                                                                    <Border Background="{DynamicResource Theme.Badge.Background}" CornerRadius="3" Padding="6,1">
                                                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="SemiBold" 
                                                                                   Foreground="{Binding OverallStatus, Converter={StaticResource StockStatusToColorConverter}}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,2,0,2"/>
                                                                <TextBlock Text="{Binding CapacityDetailsDisplay, StringFormat='Cap: {0}'}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                            </StackPanel>

                                                            <!-- Expand Icon & Occupancy % -->
                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding OccupancyDisplay}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"
                                                                           Foreground="{Binding OccupancyPercentage, Converter={StaticResource OccupancyColorConverter}}"/>
                                                                <TextBlock Text="{Binding SectionsCount, StringFormat='{}{0} Tiers'}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" HorizontalAlignment="Right"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Expandable Shelf Tiers -->
                                                    <Border Grid.Row="1" 
                                                            BorderBrush="{DynamicResource Theme.Border}" 
                                                            BorderThickness="0,1,0,0" 
                                                            Padding="8" 
                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ItemsControl ItemsSource="{Binding Sections}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:RackSection}">
                                                                    <!-- Individual Shelf Tier Button -->
                                                                    <Button Style="{StaticResource SecondaryButton}" 
                                                                            Margin="0,2" 
                                                                            Padding="8,6" 
                                                                            HorizontalContentAlignment="Stretch"
                                                                            Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock Grid.Column="0" Text="{Binding SectionCode}" FontWeight="Bold" FontSize="11" Width="50" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding SummaryDescription}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                                                            
                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding WorstStatus, Converter={StaticResource StockStatusToColorConverter}}"/>
                                                                                <TextBlock Text="{Binding TotalStockQuantity, StringFormat='{}{0:N0} qty'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Right: Selected Section & Bin Inspector Details -->
                    <Border Grid.Column="2" Style="{StaticResource IndustrialCard}">
                        <Grid>
                            <!-- If a section is selected -->
                            <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource NullToVisibilityConverter}}">
                                <!-- Section Header Details -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding SelectedSection.SectionCode, StringFormat='Section: {0}'}" FontSize="16" FontWeight="Bold"/>
                                            <Border Background="{DynamicResource Theme.Badge.Background}" CornerRadius="4" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding SelectedSection.WorstStatus}" FontWeight="SemiBold" FontSize="11"
                                                           Foreground="{Binding SelectedSection.WorstStatus, Converter={StaticResource StockStatusToColorConverter}}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedSection.Name}" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                    </StackPanel>

                                    <!-- Capacity & Load Factor -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="TIER CAPACITY &amp; LOAD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding SelectedSection.OccupancyDisplay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"
                                                   Foreground="{Binding SelectedSection.OccupancyPercentage, Converter={StaticResource OccupancyColorConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Visual Shelf Beam Representation -->
                                <Border Height="6" Background="{DynamicResource Theme.Rack.SteelFrame}" CornerRadius="3" Margin="0,0,0,16"/>

                                <!-- Empty Section State -->
                                <Border Background="{DynamicResource Theme.Surface.CardAlt}" 
                                        BorderBrush="{DynamicResource Theme.Border}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="24" 
                                        Margin="0,0,0,16"
                                        Visibility="{Binding SelectedSection.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Warehouse}" Fill="{DynamicResource Theme.Text.Muted}" Width="28" Height="28" Stretch="Uniform" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Empty Storage Tier" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="This section currently holds no assigned stock items. Ready for Goods Inward allocation." 
                                                   FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stored Products List (When Products Exist) -->
                                <StackPanel Visibility="{Binding SelectedSection.IsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="ASSIGNED SKUs &amp; BATCH DETAILS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,8"/>

                                    <ItemsControl ItemsSource="{Binding SelectedSection.Products}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:StoredProductItem}">
                                                <Border Style="{StaticResource IndustrialCardAlt}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Status Icon -->
                                                        <Border Grid.Column="0" Width="32" Height="32" 
                                                                Background="{DynamicResource Theme.Badge.Background}" 
                                                                CornerRadius="4" Margin="0,0,12,0">
                                                            <Path Data="{StaticResource Icon.Products}" Fill="{Binding Status, Converter={StaticResource StockStatusToColorConverter}}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- SKU & Product Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Sku}" FontWeight="Bold" FontSize="12" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding Category, StringFormat='({0})'}" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,2,0,2"/>
                                                            <TextBlock Text="{Binding BatchNumber, StringFormat='Batch: {0}'}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                        </StackPanel>

                                                        <!-- Expiry & Reorder Info -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding ExpiryDisplay, StringFormat='Exp: {0}'}" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                                       Foreground="{Binding Status, Converter={StaticResource StockStatusToColorConverter}}"/>
                                                        </StackPanel>

                                                        <!-- Quantity & Native Unit -->
                                                        <Border Grid.Column="3" 
                                                                Background="{DynamicResource Theme.Badge.Background}" 
                                                                BorderBrush="{DynamicResource Theme.Border}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="6" 
                                                                Padding="10,6" 
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding QuantityDisplay}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Fallback if no rack/section selected -->
                            <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource InverseNullToVisibilityConverter}}" 
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Warehouse}" Fill="{DynamicResource Theme.Text.Muted}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <TextBlock Text="Select a Rack Shelf Tier to Inspect" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SECTION 4 & 5: RECENT STOCK MOVEMENTS & ALERTS (TWO COLUMNS) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: Recent Stock Movements Ledger -->
                    <Border Grid.Column="0" Style="{StaticResource IndustrialCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Table Header & Filter -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="RECENT STOCK MOVEMENTS LEDGER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                    <TextBlock Text="Live auditable transaction records" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding ViewAllMovementsCommand}" 
                                        Padding="8,4" 
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Full Ledger →" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <!-- Table of Transactions -->
                            <ListView Grid.Row="1" ItemsSource="{Binding RecentMovements}" 
                                      Background="Transparent" 
                                      BorderThickness="0" 
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:StockMovement}">
                                        <Border BorderBrush="{DynamicResource Theme.Border.Subtle}" BorderThickness="0,0,0,1" Padding="4,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Type & Badge -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <Border CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" Background="{DynamicResource Theme.Badge.Background}">
                                                        <TextBlock Text="{Binding TypeDisplay}" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{Binding Type, Converter={StaticResource StockStatusToColorConverter}}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FormattedTimestamp}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Product & SKU -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Sku, StringFormat='SKU: {0}'}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                    <TextBlock Text="{Binding Remarks}" FontSize="10" Foreground="{DynamicResource Theme.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Locations & User -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                                                    <TextBlock Text="{Binding SourceLocation}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                                    <TextBlock Text="{Binding DestinationLocation, StringFormat='→ {0}'}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                                    <TextBlock Text="{Binding InitiatedBy, StringFormat='By: {0}'}" FontSize="9" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                </StackPanel>

                                                <!-- Quantity & Status -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding SignedQuantityDisplay}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"
                                                               Foreground="{Binding Type, Converter={StaticResource StockStatusToColorConverter}}"/>
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Column 2: Active Alerts & Notifications Panel -->
                    <Border Grid.Column="2" Style="{StaticResource IndustrialCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ACTIVE WAREHOUSE ALERTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                    <TextBlock Text="Actionable exceptions &amp; warnings" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource WarningBrush}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveAlerts.Count}" FontWeight="Bold" FontSize="11" Foreground="#000000"/>
                                </Border>
                            </Grid>

                            <!-- Alerts List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:InventoryAlert}">
                                            <Border Style="{StaticResource IndustrialCardAlt}" Margin="0,0,0,8" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <Path Grid.Column="0" Data="{StaticResource Icon.Alert}" 
                                                          Fill="{Binding Severity, Converter={StaticResource StockStatusToColorConverter}}" 
                                                          Width="14" Height="14" Stretch="Uniform" Margin="0,2,8,0" VerticalAlignment="Top"/>

                                                    <!-- Text -->
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Location}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding TimeAgo}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Dismiss / Acknowledge Action -->
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" 
                                                            Padding="4" VerticalAlignment="Top"
                                                            Command="{Binding DataContext.DismissAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Acknowledge &amp; Dismiss Alert">
                                                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ACTION FEEDBACK / NON-DESTRUCTIVE MODAL DIALOG -->
        <Grid Background="#7F000000" 
              Visibility="{Binding ShowActionFeedbackDialog, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource IndustrialCard}" 
                    MaxWidth="520" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Alert}" Fill="{StaticResource BrandAccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ActionFeedbackTitle}" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Command="{Binding CloseFeedbackDialogCommand}">
                            <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource Theme.Text.Muted}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding ActionFeedbackBody}" FontSize="13" Foreground="{DynamicResource Theme.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="18"/>

                    <Button Style="{StaticResource PrimaryButton}" 
                            Content="Acknowledge" 
                            Command="{Binding CloseFeedbackDialogCommand}" 
                            HorizontalAlignment="Right" 
                            Padding="16,6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
