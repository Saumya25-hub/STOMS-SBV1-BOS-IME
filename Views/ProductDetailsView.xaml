<UserControl x:Class="STOMS_SBV1_BOS_IME.Views.ProductDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STOMS_SBV1_BOS_IME.Views"
             xmlns:viewmodels="clr-namespace:STOMS_SBV1_BOS_IME.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ProductDetailsViewModel}">
    <Border Background="{DynamicResource Theme.Surface.Modal}" 
            BorderBrush="{DynamicResource Theme.Border}" 
            BorderThickness="1" 
            CornerRadius="10" 
            MaxWidth="960" 
            MaxHeight="840"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.65" Direction="270" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header & Quick Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Product Identity -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="{Binding Product.Status, Converter={StaticResource StockStatusToBgColorConverter}}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Product.StatusDisplay}" FontWeight="Bold" FontSize="11" Foreground="{Binding Product.Status, Converter={StaticResource StockStatusToColorConverter}}"/>
                        </Border>
                        <TextBlock Text="{Binding Product.Sku}" FontFamily="Consolas" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Product.Name}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                    <TextBlock Text="{Binding Product.Category}" FontSize="12" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding ReceiveCommand}" Margin="0,0,6,0" Padding="10,6" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Inward}" Fill="{StaticResource SuccessBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Receive Stock" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButton}" Command="{Binding IssueCommand}" Margin="0,0,6,0" Padding="10,6" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Outward}" Fill="{StaticResource DangerBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Issue Stock" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButton}" Command="{Binding EditCommand}" Margin="0,0,10,0" Padding="10,6" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Edit}" Fill="{DynamicResource Theme.Text.Primary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Edit Master" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" ToolTip="Close Details" Width="32" Height="32">
                        <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Theme.Text.Muted}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Section Navigation Tabs -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Overview &amp; Specs" Command="{Binding SetTabCommand}" CommandParameter="Overview" 
                            Style="{StaticResource TabButton}" Tag="{Binding IsOverviewTabActive}" Margin="0,0,8,0"/>
                    <Button Content="Warehouse Locations" Command="{Binding SetTabCommand}" CommandParameter="Locations" 
                            Style="{StaticResource TabButton}" Tag="{Binding IsLocationsTabActive}" Margin="0,0,8,0"/>
                    <Button Content="Batches &amp; Expiry Lots" Command="{Binding SetTabCommand}" CommandParameter="Batches" 
                            Style="{StaticResource TabButton}" Tag="{Binding IsBatchesTabActive}" Margin="0,0,8,0"
                            Visibility="{Binding Product.IsBatchTracked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Serial Registry" Command="{Binding SetTabCommand}" CommandParameter="Serials" 
                            Style="{StaticResource TabButton}" Tag="{Binding IsSerialsTabActive}" Margin="0,0,8,0"
                            Visibility="{Binding Product.IsSerialTracked, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Audit History Ledger" Command="{Binding SetTabCommand}" CommandParameter="History" 
                            Style="{StaticResource TabButton}" Tag="{Binding IsHistoryTabActive}"/>
                </StackPanel>
            </Border>

            <!-- 3. Dynamic Tab Content -->
            <Grid Grid.Row="2">

                <!-- TAB 1: OVERVIEW -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsOverviewTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Stock Balance Metric Cards Grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="PHYSICAL HOLDINGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                    <TextBlock Text="{Binding Product.PhysicalStock, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Product.Unit}" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="AVAILABLE BALANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                    <TextBlock Text="{Binding Product.AvailableStock, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Product.Unit}" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="RESERVED ALLOCATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                    <TextBlock Text="{Binding Product.ReservedStock, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Pending Sign-Off" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="QUARANTINED / EXPIRED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                    <TextBlock Text="{Binding Product.ExpiredStock, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Locked from Issue" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Specification Table Details -->
                        <Border Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tracking Architecture" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding Product.TrackingTypeDisplay}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandAccentBrush}" Margin="0,2,0,10"/>

                                    <TextBlock Text="Barcode / Scanner Tag" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding Product.BarcodeDisplay}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,2,0,10"/>

                                    <TextBlock Text="Default Storage Location" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding Product.DefaultLocationDisplay}" FontSize="13" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,2,0,10"/>
                                </StackPanel>

                                <!-- Right Column -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Safety Thresholds" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding Product.MinStockLevel, StringFormat='Min Stock: {0:N0}'}" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Product.ReorderLevel, StringFormat='Reorder Point: {0:N0}'}" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Technical Specifications &amp; Notes" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding Product.Description}" FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,10"/>

                                    <TextBlock Text="System Master Timestamp" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding Product.CreatedAt, StringFormat='Registered: {0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: LOCATIONS -->
                <DataGrid ItemsSource="{Binding LocationBalances}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          GridLinesVisibility="Horizontal" 
                          HeadersVisibility="Column"
                          Visibility="{Binding IsLocationsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Rack" Binding="{Binding RackCode}" Width="*"/>
                        <DataGridTextColumn Header="Shelf Tier" Binding="{Binding SectionCode}" Width="*"/>
                        <DataGridTextColumn Header="Physical" Binding="{Binding PhysicalQuantity, StringFormat='{}{0:N0}'}" Width="*"/>
                        <DataGridTextColumn Header="Available" Binding="{Binding AvailableQuantity, StringFormat='{}{0:N0}'}" Width="*"/>
                        <DataGridTextColumn Header="Reserved" Binding="{Binding ReservedQuantity, StringFormat='{}{0:N0}'}" Width="*"/>
                        <DataGridTextColumn Header="Quarantined" Binding="{Binding DamagedQuantity, StringFormat='{}{0:N0}'}" Width="*"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="0.7*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- TAB 3: BATCHES -->
                <DataGrid ItemsSource="{Binding Batches}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          GridLinesVisibility="Horizontal" 
                          HeadersVisibility="Column"
                          Visibility="{Binding IsBatchesTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Batch Number" Binding="{Binding BatchNumber}" Width="1.2*" FontFamily="Consolas" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Remaining Qty" Binding="{Binding RemainingQuantityDisplay}" Width="*"/>
                        <DataGridTextColumn Header="Bay Location" Binding="{Binding LocationDisplay}" Width="1.4*"/>
                        <DataGridTextColumn Header="Mfg Date" Binding="{Binding MfgDisplay}" Width="*"/>
                        <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDisplay}" Width="*"/>
                        <DataGridTemplateColumn Header="FEFO Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StockStatusToBgColorConverter}}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding Status, Converter={StaticResource StockStatusToColorConverter}}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- TAB 4: SERIALS -->
                <DataGrid ItemsSource="{Binding SerialNumbers}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          GridLinesVisibility="Horizontal" 
                          HeadersVisibility="Column"
                          Visibility="{Binding IsSerialsTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="1.4*" FontFamily="Consolas" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Batch Associated" Binding="{Binding BatchNumber}" Width="*" FontFamily="Consolas"/>
                        <DataGridTextColumn Header="Storage Location" Binding="{Binding LocationDisplay}" Width="1.4*"/>
                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StockStatusToBgColorConverter}}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding Status, Converter={StaticResource StockStatusToColorConverter}}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Received Date" Binding="{Binding ReceivedDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- TAB 5: HISTORY -->
                <DataGrid ItemsSource="{Binding Movements}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          GridLinesVisibility="Horizontal" 
                          HeadersVisibility="Column"
                          Visibility="{Binding IsHistoryTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding FormattedTimestamp}" Width="1.1*"/>
                        <DataGridTemplateColumn Header="Movement Type" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Type, Converter={StaticResource StockStatusToBgColorConverter}}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TypeDisplay}" Foreground="{Binding Type, Converter={StaticResource StockStatusToColorConverter}}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding SignedQuantityDisplay}" Width="0.9*" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Source Location" Binding="{Binding SourceLocation}" Width="1.2*"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding DestinationLocation}" Width="1.2*"/>
                        <DataGridTextColumn Header="Operator" Binding="{Binding InitiatedBy}" Width="*"/>
                        <DataGridTextColumn Header="Remarks / Ref" Binding="{Binding Remarks}" Width="1.4*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>

