<UserControl x:Class="STOMS_SBV1_BOS_IME.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STOMS_SBV1_BOS_IME.Views"
             xmlns:viewmodels="clr-namespace:STOMS_SBV1_BOS_IME.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ProductManagementViewModel}"
             d:DesignHeight="850" d:DesignWidth="1200">
    <Grid Background="{DynamicResource Theme.Background.Main}">

        <!-- MAIN VIEW LAYOUT -->
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Module Header & Quick Action Buttons -->
                <RowDefinition Height="Auto"/> <!-- 1: KPI Telemetry Counters -->
                <RowDefinition Height="Auto"/> <!-- 2: Navigation Tabs -->
                <RowDefinition Height="Auto"/> <!-- 3: Search & Multi-Filter Ribbon -->
                <RowDefinition Height="*"/>    <!-- 4: Tab Content Tables -->
            </Grid.RowDefinitions>

            <!-- 0. Module Header & Action Buttons -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Product &amp; Stock Master" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                        <Border Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MOD-PRD-02 / STK-03" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Centralized SKU catalog, multi-warehouse balances, batch &amp; FEFO traceability, and serial registry" FontSize="12" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddProductCommand}" Height="34" Margin="0,0,8,0" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Inward}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Product (SKU)" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButton}" Command="{Binding ReceiveStockCommand}" Height="34" Margin="0,0,8,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Inward}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Receive Stock" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButton}" Command="{Binding IssueStockCommand}" Height="34" Margin="0,0,8,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Outward}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Issue Stock" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButton}" Command="{Binding RefreshAllCommand}" Height="34" Padding="10,0" ToolTip="Refresh Ledger Data">
                        <Path Data="{StaticResource Icon.Refresh}" Fill="{DynamicResource Theme.Text.Secondary}" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1. KPI Telemetry Counters Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Catalog SKUs -->
                <Border Grid.Column="0" Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="TOTAL CATALOG SKUs" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            <TextBlock Text="{Binding TotalProductCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Path Data="{StaticResource Icon.Products}" Fill="{StaticResource BrandAccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Low Stock Items -->
                <Border Grid.Column="2" Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="AT / BELOW REORDER POINT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            <TextBlock Text="{Binding LowStockCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Path Data="{StaticResource Icon.LowStock}" Fill="{StaticResource WarningBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Expired Batches -->
                <Border Grid.Column="4" Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="EXPIRED LOTS (QUARANTINED)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            <TextBlock Text="{Binding ExpiredCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Path Data="{StaticResource Icon.Expired}" Fill="{StaticResource DangerBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Pending Approvals -->
                <Border Grid.Column="6" Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="PENDING SIGN-OFFS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            <TextBlock Text="{Binding PendingApprovalsCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Path Data="{StaticResource Icon.Approvals}" Fill="{StaticResource BrandAccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Navigation Tabs Bar -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Catalog Master" Command="{Binding SetSectionCommand}" CommandParameter="Catalog" 
                            Style="{StaticResource TabButton}" Tag="{Binding IsCatalogActive}" Margin="0,0,8,0"/>
                    
                    <Button Content="Stock Balances" Command="{Binding SetSectionCommand}" CommandParameter="Balances" 
                            Style="{StaticResource TabButton}" Tag="{Binding IsBalancesActive}" Margin="0,0,8,0"/>

                    <Button Content="Batch &amp; FEFO Explorer" Command="{Binding SetSectionCommand}" CommandParameter="Batches" 
                            Style="{StaticResource TabButton}" Tag="{Binding IsBatchesActive}" Margin="0,0,8,0"/>

                    <Button Content="Serial Registry" Command="{Binding SetSectionCommand}" CommandParameter="Serials" 
                            Style="{StaticResource TabButton}" Tag="{Binding IsSerialsActive}" Margin="0,0,8,0"/>

                    <Button Command="{Binding SetSectionCommand}" CommandParameter="Approvals" 
                            Style="{StaticResource TabButton}" Tag="{Binding IsApprovalsActive}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending Approvals" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource Theme.Status.Info.Bg}" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingApprovalsCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 3. Search & Multi-Filter Ribbon -->
            <Border Grid.Row="3" Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/> <!-- Search -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>   <!-- Category -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>   <!-- Tracking -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>   <!-- Status -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>   <!-- Warehouse -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/><!-- Clear Filter -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Column="0">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FormTextBox}" 
                                 Padding="28,6,8,6" 
                                 Height="32" 
                                 FontSize="12" 
                                 ToolTip="Filter by Product Name, SKU, or Barcode"/>
                        <Path Data="{StaticResource Icon.Search}" Fill="{DynamicResource Theme.Text.Muted}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Category Filter -->
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding SelectedCategory}" 
                              Style="{StaticResource FormComboBox}" Height="32" FontSize="11" ToolTip="Filter by Category"/>

                    <!-- Tracking Filter -->
                    <ComboBox Grid.Column="4" ItemsSource="{Binding TrackingTypeFilters}" 
                              SelectedItem="{Binding SelectedTrackingTypeFilter}" 
                              Style="{StaticResource FormComboBox}" Height="32" FontSize="11" ToolTip="Filter by Tracking Mode"/>

                    <!-- Status Filter -->
                    <ComboBox Grid.Column="6" ItemsSource="{Binding StatusFilters}" 
                              SelectedItem="{Binding SelectedStatusFilter}" 
                              Style="{StaticResource FormComboBox}" Height="32" FontSize="11" ToolTip="Filter by Stock Status"/>

                    <!-- Warehouse Filter -->
                    <ComboBox Grid.Column="8" ItemsSource="{Binding Warehouses}" 
                              SelectedItem="{Binding SelectedWarehouseFilter}" 
                              Style="{StaticResource FormComboBox}" Height="32" FontSize="11" ToolTip="Filter by Facility"/>

                    <!-- Clear Button -->
                    <Button Grid.Column="10" Content="Reset" Command="{Binding ClearFiltersCommand}" 
                            Style="{StaticResource OutlineButton}" Height="32" Padding="10,0" FontSize="11" ToolTip="Reset All Filters"/>
                </Grid>
            </Border>

            <!-- 4. Dynamic Tab Contents -->
            <Grid Grid.Row="4">

                <!-- TAB 1: CATALOG MASTER DATA TABLE -->
                <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" 
                        Visibility="{Binding IsCatalogActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding Products}" 
                              SelectedItem="{Binding SelectedProduct}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              GridLinesVisibility="Horizontal" 
                              HeadersVisibility="Column"
                              RowHeight="42">
                        <DataGrid.Columns>
                            <!-- Product Name & Category -->
                            <DataGridTemplateColumn Header="Product Name &amp; Description" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- SKU -->
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.3*" FontFamily="Consolas" FontWeight="Bold"/>

                            <!-- Barcode -->
                            <DataGridTextColumn Header="Barcode" Binding="{Binding BarcodeDisplay}" Width="1.1*" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Theme.Text.Secondary}"/>

                            <!-- Tracking Mode Badge -->
                            <DataGridTemplateColumn Header="Tracking" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TrackingTypeDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Physical Stock -->
                            <DataGridTextColumn Header="Physical" Binding="{Binding PhysicalStock, StringFormat='{}{0:N0}'}" Width="0.9*" FontWeight="Bold"/>

                            <!-- Available Stock -->
                            <DataGridTemplateColumn Header="Available" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AvailableStock, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Reserved -->
                            <DataGridTextColumn Header="Reserved" Binding="{Binding ReservedStock, StringFormat='{}{0:N0}'}" Width="0.8*" Foreground="{DynamicResource Theme.Text.Muted}"/>

                            <!-- Native Unit -->
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="0.6*"/>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StockStatusToBgColorConverter}}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding Status, Converter={StaticResource StockStatusToColorConverter}}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions Column -->
                            <DataGridTemplateColumn Header="Actions" Width="1.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- View -->
                                            <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="View Full Master Card" Width="26" Height="26" Margin="0,0,4,0">
                                                <Path Data="{StaticResource Icon.Eye}" Fill="{DynamicResource Theme.Text.Secondary}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                            <!-- Edit -->
                                            <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Edit Product Master" Width="26" Height="26" Margin="0,0,4,0">
                                                <Path Data="{StaticResource Icon.Edit}" Fill="{DynamicResource Theme.Text.Secondary}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                            <!-- Receive -->
                                            <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.ReceiveStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Receive Stock Inward" Width="26" Height="26" Margin="0,0,4,0">
                                                <Path Data="{StaticResource Icon.Inward}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                            <!-- Issue -->
                                            <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.IssueStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Issue Stock Outward" Width="26" Height="26">
                                                <Path Data="{StaticResource Icon.Outward}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- TAB 2: STOCK BALANCES BY STORAGE LOCATION -->
                <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" 
                        Visibility="{Binding IsBalancesActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding LocationBalances}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              GridLinesVisibility="Horizontal" 
                              HeadersVisibility="Column"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.2*" FontFamily="Consolas" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Warehouse Facility" Binding="{Binding WarehouseName}" Width="1.8*"/>
                            <DataGridTextColumn Header="Rack Code" Binding="{Binding RackCode}" Width="*"/>
                            <DataGridTextColumn Header="Shelf Tier" Binding="{Binding SectionCode}" Width="*"/>
                            <DataGridTextColumn Header="Physical" Binding="{Binding PhysicalQuantity, StringFormat='{}{0:N0}'}" Width="0.9*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Available" Binding="{Binding AvailableQuantity, StringFormat='{}{0:N0}'}" Width="0.9*" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            <DataGridTextColumn Header="Reserved" Binding="{Binding ReservedQuantity, StringFormat='{}{0:N0}'}" Width="0.8*" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            <DataGridTextColumn Header="Quarantined" Binding="{Binding DamagedQuantity, StringFormat='{}{0:N0}'}" Width="0.9*" Foreground="{StaticResource DangerBrush}"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="0.6*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- TAB 3: BATCH & FEFO EXPLORER -->
                <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" 
                        Visibility="{Binding IsBatchesActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding Batches}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              GridLinesVisibility="Horizontal" 
                              HeadersVisibility="Column"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Batch Number" Binding="{Binding BatchNumber}" Width="1.3*" FontFamily="Consolas" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.2*" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Warehouse Location" Binding="{Binding LocationDisplay}" Width="1.6*"/>
                            <DataGridTextColumn Header="Remaining / Received" Binding="{Binding RemainingQuantityDisplay}" Width="1.2*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Mfg Date" Binding="{Binding MfgDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDisplay}" Width="*"/>
                            <DataGridTemplateColumn Header="FEFO Expiry Health" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StockStatusToBgColorConverter}}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding Status, Converter={StaticResource StockStatusToColorConverter}}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- TAB 4: SERIAL NUMBERS REGISTRY -->
                <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" 
                        Visibility="{Binding IsSerialsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding SerialNumbers}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              GridLinesVisibility="Horizontal" 
                              HeadersVisibility="Column"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="1.6*" FontFamily="Consolas" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.2*" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Batch Associated" Binding="{Binding BatchNumber}" Width="1.2*" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Storage Location" Binding="{Binding LocationDisplay}" Width="1.6*"/>
                            <DataGridTemplateColumn Header="Status" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StockStatusToBgColorConverter}}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding Status, Converter={StaticResource StockStatusToColorConverter}}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Received Date" Binding="{Binding ReceivedDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- TAB 5: PENDING APPROVALS SIGN-OFF TABLE -->
                <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" 
                        Visibility="{Binding IsApprovalsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding PendingApprovals}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              GridLinesVisibility="Horizontal" 
                              HeadersVisibility="Column"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Request Ref #" Binding="{Binding RequestId}" Width="1.2*" FontFamily="Consolas" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.2*" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding LocationDisplay}" Width="1.6*"/>
                            <DataGridTextColumn Header="Reason &amp; Requester" Binding="{Binding Reason}" Width="1.8*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding RequestedAtDisplay}" Width="1.2*"/>
                            <DataGridTemplateColumn Header="Dual Sign-Off Authorization" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.ApproveRequestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Height="28" Padding="10,0" Margin="0,0,6,0">
                                                <TextBlock Text="✓ Approve" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Style="{StaticResource DangerButton}" Command="{Binding DataContext.RejectRequestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Height="28" Padding="10,0">
                                                <TextBlock Text="✕ Reject" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- FLOATING FEEDBACK BANNER (TOAST NOTIFICATION) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" 
                Background="{DynamicResource Theme.Surface.Primary}" 
                BorderBrush="{StaticResource BrandAccentBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="14,10" MaxWidth="450"
                Visibility="{Binding IsFeedbackVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource Icon.Check}" Fill="{StaticResource SuccessBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding FeedbackMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Primary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding DismissFeedbackCommand}" Width="20" Height="20" Margin="8,0,0,0">
                    <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Theme.Text.Muted}" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- MODAL OVERLAYS (FROSTED BACKDROP) -->

        <!-- 1. Product Form Modal (Add / Edit) -->
        <Grid Background="#80000000" Visibility="{Binding IsProductFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:ProductFormDialog DataContext="{Binding CurrentProductForm}"/>
        </Grid>

        <!-- 2. Stock Receive Modal -->
        <Grid Background="#80000000" Visibility="{Binding IsReceiveFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:StockReceiveDialog DataContext="{Binding CurrentReceiveForm}"/>
        </Grid>

        <!-- 3. Stock Issue Modal -->
        <Grid Background="#80000000" Visibility="{Binding IsIssueFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:StockIssueDialog DataContext="{Binding CurrentIssueForm}"/>
        </Grid>

        <!-- 4. Product Details Modal -->
        <Grid Background="#80000000" Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:ProductDetailsView DataContext="{Binding CurrentProductDetails}"/>
        </Grid>

    </Grid>
</UserControl>
