<UserControl x:Class="STOMS_SBV1_BOS_IME.Views.StockIssueDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STOMS_SBV1_BOS_IME.Views"
             xmlns:viewmodels="clr-namespace:STOMS_SBV1_BOS_IME.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:StockIssueViewModel}">
    <Border Background="{DynamicResource Theme.Surface.Modal}" 
            BorderBrush="{DynamicResource Theme.Border}" 
            BorderThickness="1" 
            CornerRadius="10" 
            MaxWidth="760" 
            MaxHeight="840"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.65" Direction="270" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource Theme.Status.Danger.Bg}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="- GOODS OUTWARD" FontWeight="Bold" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                        </Border>
                        <TextBlock Text="Stock Issue &amp; Requisition" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                    </StackPanel>
                    <TextBlock Text="Issue materials from inventory, select FEFO batches, verify serials, and route sign-offs" FontSize="12" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding CancelCommand}" ToolTip="Close dialog" Width="30" Height="30">
                    <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Theme.Text.Muted}" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- 2. Error Message Banner -->
            <Border Grid.Row="1" Background="{DynamicResource Theme.Status.Danger.Bg}" 
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" 
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Alert}" Fill="{StaticResource DangerBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 3. Scrollable Form -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                    <!-- Product Selection -->
                    <TextBlock Text="Select Item to Issue *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Products}" 
                              SelectedItem="{Binding SelectedProduct}" 
                              DisplayMemberPath="Name" 
                              Style="{StaticResource FormComboBox}" Height="36"/>

                    <!-- Real-Time Stock Telemetry Snapshot -->
                    <Border Background="{DynamicResource Theme.Surface.Secondary}" 
                            BorderBrush="{DynamicResource Theme.Border}" 
                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SKU CODE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                <TextBlock Text="{Binding ProductSku}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandAccentBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="AVAILABLE BALANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                <TextBlock Text="{Binding AvailableStock, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PHYSICAL HOLDINGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                <TextBlock Text="{Binding PhysicalStock, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Text.Primary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="RESERVED ALLOCATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                <TextBlock Text="{Binding ReservedStock, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandAccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quantity & Source Location Row -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Quantity -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Issue Quantity *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <Grid>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource FormTextBox}" 
                                         FontWeight="Bold" FontSize="14" Padding="8,6,36,6"/>
                                <TextBlock Text="{Binding ProductUnit}" Foreground="{DynamicResource Theme.Text.Muted}" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                            </Grid>
                        </StackPanel>

                        <!-- Source Warehouse / Rack / Section -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Source Storage Bay *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" ItemsSource="{Binding Warehouses}" 
                                          SelectedItem="{Binding SelectedWarehouse}" 
                                          DisplayMemberPath="Code" 
                                          Style="{StaticResource FormComboBox}" Height="34" ToolTip="Warehouse Facility"/>

                                <ComboBox Grid.Column="2" ItemsSource="{Binding Racks}" 
                                          SelectedItem="{Binding SelectedRack}" 
                                          DisplayMemberPath="RackCode" 
                                          Style="{StaticResource FormComboBox}" Height="34" ToolTip="Storage Rack"/>

                                <ComboBox Grid.Column="4" ItemsSource="{Binding Sections}" 
                                          SelectedItem="{Binding SelectedSection}" 
                                          DisplayMemberPath="SectionCode" 
                                          Style="{StaticResource FormComboBox}" Height="34" ToolTip="Shelf Tier"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Batch Selection (Dynamic) -->
                    <Border Background="{DynamicResource Theme.Surface.Secondary}" 
                            BorderBrush="{DynamicResource Theme.Border}" 
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,0"
                            Visibility="{Binding IsBatchTracked, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="SELECT PRODUCTION BATCH (FEFO RECOMMENDED)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}"/>
                                <Button Content="Auto FEFO (First Expire First Out)" Command="{Binding AutoSelectFefoBatchCommand}" 
                                        HorizontalAlignment="Right" Style="{StaticResource OutlineButton}" FontSize="11" Padding="8,2" Height="22"
                                        ToolTip="Automatically prioritizes the batch with the closest valid expiration date"/>
                            </Grid>

                            <ComboBox ItemsSource="{Binding AvailableBatches}" 
                                      SelectedItem="{Binding SelectedBatch}" 
                                      Style="{StaticResource FormComboBox}" Height="36">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding BatchNumber}" FontFamily="Consolas" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RemainingQuantityDisplay}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ExpiryDisplay, StringFormat='Exp: {0}'}" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Serial Selection (Dynamic) -->
                    <Border Background="{DynamicResource Theme.Surface.Secondary}" 
                            BorderBrush="{DynamicResource Theme.Border}" 
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,0"
                            Visibility="{Binding IsSerialTracked, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSerialsCountLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" Margin="0,0,0,6"/>

                            <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" MaxHeight="130">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AvailableSerials}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Padding="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SerialNumber}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding LocationDisplay}" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Classification: Reason, Work Order Ref -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Issue Reason / Cost Center *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding IssueReasons}" 
                                      SelectedItem="{Binding SelectedReason}" 
                                      Style="{StaticResource FormComboBox}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Work Order / Requisition Ref #" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormTextBox}" Height="34"/>
                        </StackPanel>
                    </Grid>

                    <!-- Remarks & Notes -->
                    <TextBlock Text="Issue Notes / Destination Station" Style="{StaticResource SectionHeader}" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource FormTextBox}" Height="40" TextWrapping="Wrap"/>

                    <!-- Supervisor Approval Routing Toggle -->
                    <Border Background="{DynamicResource Theme.Surface.Secondary}" 
                            BorderBrush="{DynamicResource Theme.Border}" 
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                        <CheckBox IsChecked="{Binding RequiresApproval}" VerticalAlignment="Center">
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Route for Supervisor Sign-Off &amp; Dual Authorization" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                <TextBlock Text="Places stock in Reserved state. Inventory remains safely held until manager reviews and approves." FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Footer Buttons -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OutlineButton}" 
                            Command="{Binding CancelCommand}" HorizontalAlignment="Left" Width="100" Height="36"/>

                    <Button Grid.Column="1" Style="{StaticResource DangerButton}" 
                            Command="{Binding SubmitCommand}" Width="190" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Outward}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Authorize Stock Out" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

