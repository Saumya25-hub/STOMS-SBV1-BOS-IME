<UserControl x:Class="STOMS_SBV1_BOS_IME.Views.ProductFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STOMS_SBV1_BOS_IME.Views"
             xmlns:viewmodels="clr-namespace:STOMS_SBV1_BOS_IME.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ProductFormViewModel}">
    <Border Background="{DynamicResource Theme.Surface.Modal}" 
            BorderBrush="{DynamicResource Theme.Border}" 
            BorderThickness="1" 
            CornerRadius="10" 
            MaxWidth="760" 
            MaxHeight="800"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.65" Direction="270" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                    <TextBlock Text="Configure master SKU, tracking mode, and storage topology" FontSize="12" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding CancelCommand}" ToolTip="Close dialog" Width="30" Height="30">
                    <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Theme.Text.Muted}" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- 2. Error Message Banner -->
            <Border Grid.Row="1" Background="{DynamicResource Theme.Status.Danger.Bg}" 
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" 
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Alert}" Fill="{StaticResource DangerBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 3. Form Content (Scrollable) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                    <!-- Product Name -->
                    <TextBlock Text="Product Master Name *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource FormTextBox}" 
                             FontSize="13" 
                             ToolTip="Enter the complete industrial part or component name"/>

                    <!-- SKU & Barcode Row -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SKU -->
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="SKU (Unique Code) *" Style="{StaticResource SectionHeader}"/>
                                <Button Content="Auto-Gen" Command="{Binding RegenerateSkuCommand}" 
                                        HorizontalAlignment="Right" FontSize="11" Padding="6,1" 
                                        Style="{StaticResource OutlineButton}" Height="20" ToolTip="Regenerate automatic SKU from category &amp; name"/>
                            </Grid>
                            <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormTextBox}" 
                                     FontFamily="Consolas" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Unique catalog identifier (e.g. SKU-BRG-6205)" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Barcode (Optional) -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Barcode (Optional)" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <Grid>
                                <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource FormTextBox}" 
                                         FontFamily="Consolas" FontSize="12" Padding="28,6,8,6"/>
                                <Path Data="{StaticResource Icon.Barcode}" Fill="{DynamicResource Theme.Text.Muted}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="EAN-13, UPC or QR code string" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Category & Unit Row -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Product Category *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Categories}" 
                                      SelectedItem="{Binding SelectedCategory}" 
                                      Style="{StaticResource FormComboBox}" Height="34"/>
                        </StackPanel>

                        <!-- Unit -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unit of Measurement (UOM) *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Units}" 
                                      SelectedItem="{Binding Unit}" 
                                      Style="{StaticResource FormComboBox}" Height="34"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tracking Configuration -->
                    <Border Background="{DynamicResource Theme.Surface.Secondary}" 
                            BorderBrush="{DynamicResource Theme.Border}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="14" 
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="INVENTORY TRACKING ENGINE CONFIGURATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" Margin="0,0,0,8"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tracking Granularity *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding TrackingTypes}" 
                                              SelectedItem="{Binding SelectedTrackingType}" 
                                              Style="{StaticResource FormComboBox}" Height="34"/>
                                    <TextBlock Text="Dictates batch/serial fields during stock inward/outward" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Requires Expiry Toggle -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,12,0,0"
                                            Visibility="{Binding CanConfigureExpiry, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <CheckBox IsChecked="{Binding RequiresExpiry}" VerticalAlignment="Center">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Enforce Expiry Date (Perishable / FEFO)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                            <TextBlock Text="Mandates future expiry date during Goods Inward receipt" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Thresholds: Min Stock & Reorder Point -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Minimum Stock Safety Level *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding MinStockLevel, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormTextBox}"/>
                            <TextBlock Text="Alert triggered when stock falls below this level" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Reorder Point Level *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource FormTextBox}"/>
                            <TextBlock Text="Procurement reorder trigger threshold" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Default Storage Topology -->
                    <TextBlock Text="Default Storage Topology (Warehouse / Rack / Tier)" Style="{StaticResource SectionHeader}" Margin="0,16,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Warehouse -->
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Warehouses}" 
                                  SelectedItem="{Binding SelectedWarehouse}" 
                                  DisplayMemberPath="Code" 
                                  Style="{StaticResource FormComboBox}" Height="34" ToolTip="Select Default Warehouse"/>

                        <!-- Rack -->
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Racks}" 
                                  SelectedItem="{Binding SelectedRack}" 
                                  DisplayMemberPath="RackCode" 
                                  Style="{StaticResource FormComboBox}" Height="34" ToolTip="Select Default Rack"/>

                        <!-- Section -->
                        <ComboBox Grid.Column="4" ItemsSource="{Binding Sections}" 
                                  SelectedItem="{Binding SelectedSection}" 
                                  DisplayMemberPath="SectionCode" 
                                  Style="{StaticResource FormComboBox}" Height="34" ToolTip="Select Default Tier Section"/>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="Item Description / Technical Specifications" Style="{StaticResource SectionHeader}" Margin="0,16,0,4"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource FormTextBox}" 
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- Active Status -->
                    <CheckBox IsChecked="{Binding IsActive}" Margin="0,14,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Active Product (Available for stock movements and requisitions)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}"/>
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Footer Buttons -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OutlineButton}" 
                            Command="{Binding CancelCommand}" HorizontalAlignment="Left" Width="100" Height="36"/>

                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" 
                            Command="{Binding SaveCommand}" Width="160" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Check}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" Visibility="Collapsed"/>
                            <TextBlock Text="Save Product" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

