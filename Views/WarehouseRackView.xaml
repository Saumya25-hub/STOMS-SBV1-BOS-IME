<UserControl x:Class="STOMS_SBV1_BOS_IME.Views.WarehouseRackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STOMS_SBV1_BOS_IME.Views"
             xmlns:viewmodels="clr-namespace:STOMS_SBV1_BOS_IME.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:WarehouseRackViewModel}"
             d:DesignHeight="850" d:DesignWidth="1280">
    <Grid Background="{DynamicResource Theme.Background.Main}">
        <!-- Main Layout: Top Toolbar, Center Workspace + Right Inspector -->
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & Studio Toolbar -->
                <RowDefinition Height="*"/>    <!-- Canvas + Inspector Split -->
            </Grid.RowDefinitions>

            <!-- 1. Header & Studio Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Telemetry -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Visual Warehouse &amp; Rack Topology" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                        <Border Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MOD-WH-04 / TOPOLOGY-STUDIO" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Interactive multi-tier warehouse rack visualizer, storage bay occupancy modeling, and slotting distribution" FontSize="12" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Studio Toolbar Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Warehouse Selector -->
                    <ComboBox ItemsSource="{Binding Warehouses}" 
                              SelectedItem="{Binding SelectedWarehouse}" 
                              DisplayMemberPath="Name" 
                              Style="{StaticResource FormComboBox}" 
                              Width="260" Height="34" Margin="0,0,8,0" 
                              ToolTip="Filter by Warehouse Facility"/>

                    <!-- Search Filter -->
                    <Grid Width="180" Margin="0,0,8,0">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FormTextBox}" 
                                 Height="34" Padding="28,6,8,6" 
                                 ToolTip="Search by Rack Code or Zone"/>
                        <Path Data="{StaticResource Icon.Search}" Fill="{DynamicResource Theme.Text.Muted}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Zoom Controls -->
                    <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Height="34" Margin="0,0,8,0" Padding="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource CanvasToolButton}" Command="{Binding ZoomOutCommand}" Width="28" ToolTip="Zoom Out">
                                <TextBlock Text="-" FontWeight="Bold" FontSize="14"/>
                            </Button>
                            <TextBlock Text="{Binding ZoomDisplay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" Width="36" TextAlignment="Center"/>
                            <Button Style="{StaticResource CanvasToolButton}" Command="{Binding ZoomInCommand}" Width="28" ToolTip="Zoom In">
                                <TextBlock Text="+" FontWeight="Bold" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource CanvasToolButton}" Command="{Binding ResetZoomCommand}" Margin="4,0,0,0" Padding="6,0" ToolTip="Reset Zoom (100%)">
                                <TextBlock Text="100%" FontSize="10"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Designer Wizard Button -->
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenRackDesignerCommand}" Height="34" Margin="0,0,8,0" Padding="12,0" ToolTip="Open Visual Drag-and-Drop Rack Canvas Designer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📐 Visual Designer" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Add Rack Action -->
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenAddRackCommand}" Height="34" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+ Add Rack Bay" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Split Workspace: Interactive Bays Floor (Left) + Selected Bay Inspector (Right) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Warehouse Layout Floor Canvas -->
                <Border Grid.Column="0" Background="{DynamicResource Theme.Canvas.Background}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <!-- Zoom Transform Container -->
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                            </Grid.LayoutTransform>

                            <!-- ItemsControl of Rack Storage Bays -->
                            <ItemsControl ItemsSource="{Binding Racks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Rack Card Visual Representation -->
                                        <Button Command="{Binding DataContext.SelectRackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Background="Transparent" BorderThickness="0" Padding="0" Margin="8" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="rackBorder" 
                                                            Background="{DynamicResource Theme.Surface.Primary}" 
                                                            BorderBrush="{DynamicResource Theme.Border}" 
                                                            BorderThickness="1.5" 
                                                            CornerRadius="8" 
                                                            Width="280" 
                                                            Padding="14">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Direction="270"/>
                                                        </Border.Effect>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/> <!-- Rack Header & Status -->
                                                                <RowDefinition Height="Auto"/> <!-- Occupancy Load Bar -->
                                                                <RowDefinition Height="Auto"/> <!-- Shelf Tiers -->
                                                                <RowDefinition Height="Auto"/> <!-- Footer Details -->
                                                            </Grid.RowDefinitions>

                                                            <!-- Row 0: Code & Status -->
                                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="28" Height="28" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="4" Margin="0,0,8,0">
                                                                        <Path Data="{StaticResource Icon.Warehouse}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding RackCode}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                                                        <TextBlock Text="{Binding Zone}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <Border Grid.Column="1" HorizontalAlignment="Right" Background="{Binding OverallStatus, Converter={StaticResource StockStatusToBgColorConverter}}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding OverallStatus, Converter={StaticResource StockStatusToColorConverter}}" FontSize="10" FontWeight="Bold" Foreground="{Binding OverallStatus, Converter={StaticResource StockStatusToColorConverter}}"/>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Row 1: Occupancy Bar -->
                                                            <Border Grid.Row="1" Margin="0,0,0,10">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,3">
                                                                        <TextBlock Text="Occupancy Load" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                                        <TextBlock Text="{Binding OccupancyDisplay}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{Binding OverallStatus, Converter={StaticResource StockStatusToColorConverter}}"/>
                                                                    </Grid>
                                                                    <Border Height="6" Background="{DynamicResource Theme.Border.Subtle}" CornerRadius="3" ClipToBounds="True">
                                                                        <ProgressBar Value="{Binding OccupancyPercentage}" Maximum="100" Height="6" BorderThickness="0" Background="Transparent" Foreground="{Binding OverallStatus, Converter={StaticResource StockStatusToColorConverter}}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Row 2: Shelf Tiers Mini Preview -->
                                                            <Border Grid.Row="2" Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                                <ItemsControl ItemsSource="{Binding Sections}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding SectionCode}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,6,0"/>
                                                                                <TextBlock Grid.Column="1" Text="{Binding SummaryDescription}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Grid.Column="2" Text="{Binding TotalStockQuantity, StringFormat='{}{0:N0} Qty'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>

                                                            <!-- Row 3: Footer Spec -->
                                                            <Grid Grid.Row="3">
                                                                <TextBlock Text="{Binding CapacityDetailsDisplay}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding SectionsCount, StringFormat='{}{0} Tiers'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="rackBorder" Property="BorderBrush" Value="{StaticResource BrandAccentBrush}"/>
                                                            <Setter TargetName="rackBorder" Property="Background" Value="{DynamicResource Theme.Surface.Selected}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="rackBorder" Property="BorderBrush" Value="{DynamicResource Theme.Border.Focus}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Right: Selected Rack Inspection & Operation Panel -->
                <Border Grid.Column="1" Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Selected Bay Details -->
                            <RowDefinition Height="Auto"/> <!-- Quick Allocation Actions -->
                            <RowDefinition Height="*"/>    <!-- Loaded Items in Bay -->
                        </Grid.RowDefinitions>

                        <!-- Selected Bay Specs -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{Binding SelectedRack.OverallStatus, Converter={StaticResource StockStatusToBgColorConverter}}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedRack.OverallStatus, Converter={StaticResource StockStatusToColorConverter}}" FontWeight="Bold" FontSize="11" Foreground="{Binding SelectedRack.OverallStatus, Converter={StaticResource StockStatusToColorConverter}}"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedRack.RackCode}" FontFamily="Consolas" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedRack.Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                            <TextBlock Text="{Binding SelectedRack.WarehouseName}" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,2,0,0"/>

                            <!-- Capacity Snapshot Card -->
                            <Border Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="RACK LOAD CAPACITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                        <TextBlock Text="{Binding SelectedRack.CapacityDetailsDisplay}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="BAY OCCUPANCY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                        <TextBlock Text="{Binding SelectedRack.OccupancyDisplay}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrandAccentBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Quick Operations Toolbar -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,1" Padding="0,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Command="{Binding ReceiveIntoBayCommand}" Height="32">
                                    <TextBlock Text="+ Inward to Bay" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Command="{Binding IssueFromBayCommand}" Height="32">
                                    <TextBlock Text="- Issue from Bay" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Loaded Shelves & Tiers List -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="LOADED TIERS &amp; PRODUCTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedRack.Sections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding SectionCode}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                                        <TextBlock Text="{Binding OccupancyDisplay}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,6"/>

                                                    <!-- Items in this Tier -->
                                                    <ItemsControl ItemsSource="{Binding Products}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Sku}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource BrandAccentBrush}"/>
                                                                            <TextBlock Text="{Binding BatchNumber, StringFormat='Batch: {0}'}" FontSize="9.5" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding QuantityDisplay}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}" HorizontalAlignment="Right"/>
                                                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="9.5" Foreground="{Binding Status, Converter={StaticResource StockStatusToColorConverter}}" HorizontalAlignment="Right"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ADD RACK MODAL DIALOG -->
        <Grid Background="{DynamicResource Theme.Modal.Backdrop}" Visibility="{Binding IsAddRackOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource Theme.Surface.Modal}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="10" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.65" Direction="270" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Add New Storage Rack Bay" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                            <TextBlock Text="Provision a physical rack bay in the active warehouse topology" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Command="{Binding CancelNewRackCommand}">
                            <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource Theme.Text.Muted}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Rack Code (e.g. RCK-C-01) *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewRackCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="Rack Display Name *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewRackName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="Zone / Aisle Identifier *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewRackZone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="Max Weight Load Capacity (kg) *" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewRackCapacity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource OutlineButton}" Command="{Binding CancelNewRackCommand}" HorizontalAlignment="Left" Width="100" Height="34"/>
                        <Button Grid.Column="1" Content="Create Rack" Style="{StaticResource PrimaryButton}" Command="{Binding SaveNewRackCommand}" Width="140" Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

