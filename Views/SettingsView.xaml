<UserControl x:Class="STOMS_SBV1_BOS_IME.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STOMS_SBV1_BOS_IME.Views"
             xmlns:viewmodels="clr-namespace:STOMS_SBV1_BOS_IME.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">
    <Grid Background="{DynamicResource Theme.Background.Main}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,32" MaxWidth="1000" HorizontalAlignment="Left">

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="System Settings &amp; Preferences" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                            <Border Background="{DynamicResource Theme.Surface.Secondary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MOD-SET-09" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Centralized appearance, language localization, telemetry endpoint, and hardware profile" FontSize="12" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- SECTION 1: APPEARANCE & THEME SYSTEM -->
                <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE &amp; THEME MANAGEMENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Select your visual working environment. All cards, tables, inputs, and dialogs dynamically synchronize." FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Dark Mode -->
                            <Button Grid.Column="0" Command="{Binding SetThemeDarkCommand}" Style="{StaticResource OutlineButton}" Padding="16,14" Height="Auto" HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#1E3A8A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Dark Theme (Default)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                    </StackPanel>
                                    <TextBlock Text="Optimized for industrial low-glare control rooms and shift workstations." FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Light Mode -->
                            <Button Grid.Column="2" Command="{Binding SetThemeLightCommand}" Style="{StaticResource OutlineButton}" Padding="16,14" Height="Auto" HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Light Theme" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                    </StackPanel>
                                    <TextBlock Text="High-contrast crisp white paper aesthetic for office and bright ambient lighting." FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. System Default -->
                            <Button Grid.Column="4" Command="{Binding SetThemeSystemCommand}" Style="{StaticResource OutlineButton}" Padding="16,14" Height="Auto" HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="System Default" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                    </StackPanel>
                                    <TextBlock Text="Automatically aligns with the active Windows OS personalization setting." FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: LANGUAGE & LOCALIZATION -->
                <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="LANGUAGE &amp; REGIONAL TERMINOLOGY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Choose operational language terminology suitable for local warehouse floor teams." FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetLanguageEnCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,10,0" Padding="18,8" Height="38">
                                <TextBlock Text="English (Standard Business)" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                            <Button Command="{Binding SetLanguageHiCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,10,0" Padding="18,8" Height="38">
                                <TextBlock Text="हिंदी (Hindi Operations)" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                            <Button Command="{Binding SetLanguageHinglishCommand}" Style="{StaticResource OutlineButton}" Padding="18,8" Height="38">
                                <TextBlock Text="Hinglish (Conversational)" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: API & ARCHITECTURE PROFILE -->
                <Border Background="{DynamicResource Theme.Surface.Primary}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SYSTEM ARCHITECTURE &amp; TELEMETRY CONFIGURATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Multi-workstation network parameters and database synchronization." FontSize="12" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Central ASP.NET Core API Server Endpoint" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ApiEndpoint}" Style="{StaticResource FormTextBox}" FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Application Release Engine" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding AppVersion}" Style="{StaticResource FormTextBox}" IsReadOnly="True" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Runtime Environment" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding RuntimeFramework}" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Database Architecture Rule" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                <TextBlock Text="No direct network SQLite file sharing — central API enforces database integrity" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Save Action Button -->
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" Width="160" Height="36" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Check}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save Preferences" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Toast Notification -->
                <Border Background="{DynamicResource Theme.Status.Success.Bg}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,16,0,0"
                        Visibility="{Binding IsSavedNotificationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Check}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding FeedbackMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Command="{Binding DismissFeedbackCommand}" HorizontalAlignment="Right">
                            <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}"/>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
