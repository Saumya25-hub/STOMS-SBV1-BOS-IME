<Window x:Class="STOMS_SBV1_BOS_IME.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STOMS_SBV1_BOS_IME"
        xmlns:viewmodels="clr-namespace:STOMS_SBV1_BOS_IME.ViewModels"
        xmlns:views="clr-namespace:STOMS_SBV1_BOS_IME.Views"
        mc:Ignorable="d"
        Title="STOMS Business Operating System — Inventory Management Engine (BOS-IME)" 
        Height="840" Width="1360"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Background.Primary}">

    <Window.Resources>
        <!-- Mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PlaceholderViewModel}">
            <views:PlaceholderView/>
        </DataTemplate>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.Sidebar.ItemHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Collapsible Sidebar: width bound to ViewModel state -->
            <ColumnDefinition Width="Auto"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- A. LEFT SIDEBAR NAVIGATION -->
        <Border Grid.Column="0" 
                Background="{DynamicResource Theme.Sidebar.Background}" 
                BorderBrush="{DynamicResource Theme.Sidebar.Border}" 
                BorderThickness="0,0,1,0">
            <Grid>
                <!-- Width based on collapsed state -->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="240"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="64"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <!-- Brand Logo -->
                    <RowDefinition Height="Auto"/>
                    <!-- Nav Items -->
                    <RowDefinition Height="*"/>
                    <!-- Sidebar Footer / Collapse toggle -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource Theme.Sidebar.Border}" BorderThickness="0,0,0,1" Padding="14,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- STOMS Hexagon / Cube Logo Icon -->
                        <Border Grid.Column="0" Width="34" Height="34" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="6" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Warehouse}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Brand Title (Hidden when collapsed) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                                    Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="STOMS BOS" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Theme.Text.Primary}"/>
                            <TextBlock Text="Inventory Engine v1.0" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,12">

                        <!-- Home Dashboard -->
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Dashboard}" Fill="{StaticResource BrandAccentBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Home Dashboard" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- Product Management -->
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Products" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Products}" Fill="{DynamicResource Theme.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Product Catalog" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- Stock Management -->
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Stock" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Stock}" Fill="{DynamicResource Theme.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Stock Management" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- Warehouse & Rack Management -->
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Warehouse" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Warehouse}" Fill="{DynamicResource Theme.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Warehouse &amp; Racks" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- Stock Movements -->
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Movements" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Movements}" Fill="{DynamicResource Theme.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Stock Movements" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- Approvals -->
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Approvals" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Approvals}" Fill="{DynamicResource Theme.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Approvals" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- Reports & Analytics -->
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Reports" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Reports}" Fill="{DynamicResource Theme.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Reports &amp; Analytics" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- Separator -->
                        <Border Height="1" Background="{DynamicResource Theme.Sidebar.Border}" Margin="6,12"/>

                        <!-- User Management -->
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Users" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Users}" Fill="{DynamicResource Theme.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="User Management" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- Settings -->
                        <Button Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Settings}" Fill="{DynamicResource Theme.Text.Secondary}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Settings" FontSize="13" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer: Collapse Toggle Button -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.Sidebar.Border}" BorderThickness="0,1,0,0" Padding="10">
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleSidebarCommand}" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Menu}" Fill="{DynamicResource Theme.Text.Secondary}" Width="16" Height="16" Stretch="Uniform"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- B & C: TOP HEADER & MAIN CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Header -->
                <RowDefinition Height="Auto"/>
                <!-- Main Body -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- B. TOP HEADER -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource Theme.Header.Background}" 
                    BorderBrush="{DynamicResource Theme.Header.Border}" 
                    BorderThickness="0,0,0,1" 
                    Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Title & Breadcrumb -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Spacer / Search Bar -->
                        <ColumnDefinition Width="*"/>
                        <!-- Actions & User Profile -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Breadcrumb -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Breadcrumb}" FontSize="11" Foreground="{DynamicResource Theme.Text.Muted}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding PageTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Text.Primary}"/>
                    </StackPanel>

                    <!-- Global Product / SKU Search Bar -->
                    <Grid Grid.Column="1" MaxWidth="400" Margin="32,0" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource ModernTextBox}" 
                                 Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="32,6,10,6"
                                 ToolTip="Type SKU, Product name, or Batch number and press Enter"/>
                        <!-- Search Icon -->
                        <Path Data="{StaticResource Icon.Search}" Fill="{DynamicResource Theme.Text.Muted}" 
                              Width="14" Height="14" Stretch="Uniform" 
                              HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Header Right Actions: SignalR Status, Theme Toggle, Notifications, Profile -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Real-time Status Indicator -->
                        <Border Background="{DynamicResource Theme.Badge.Background}" 
                                BorderBrush="{DynamicResource Theme.Border}" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="8,4" 
                                Margin="0,0,12,0" 
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RealtimeStatusDescription}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Theme Toggle Button -->
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Toggle Light / Dark Mode" Margin="0,0,8,0">
                            <Path Data="{StaticResource Icon.Sun}" Fill="{DynamicResource Theme.Text.Primary}" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>

                        <!-- Notifications Bell -->
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleNotificationsCommand}" ToolTip="Warehouse Notifications &amp; Alerts" Margin="0,0,16,0">
                            <Grid>
                                <Path Data="{StaticResource Icon.Bell}" Fill="{DynamicResource Theme.Text.Primary}" Width="16" Height="16" Stretch="Uniform"/>
                                <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"/>
                            </Grid>
                        </Button>

                        <!-- Vertical Divider -->
                        <Border Width="1" Height="24" Background="{DynamicResource Theme.Border}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <!-- User Profile Info -->
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Command="{Binding ToggleUserMenuCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- User Avatar -->
                                <Border Width="34" Height="34" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="17" Margin="0,0,10,0">
                                    <TextBlock Text="SC" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Name & Role -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUser.FullName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.Text.Primary}"/>
                                    <TextBlock Text="{Binding CurrentUser.DisplayRole}" FontSize="10" Foreground="{DynamicResource Theme.Text.Muted}"/>
                                </StackPanel>

                                <Path Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource Theme.Text.Muted}" Width="10" Height="10" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- C. MAIN DASHBOARD CONTENT (Dynamic ViewPresenter) -->
            <ContentPresenter Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
