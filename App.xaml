<Application x:Class="STOMS_SBV1_BOS_IME.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:STOMS_SBV1_BOS_IME"
             xmlns:converters="clr-namespace:STOMS_SBV1_BOS_IME.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/DarkTheme.xaml"/>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Value Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:NullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" Invert="True"/>
            <converters:StockStatusToColorConverter x:Key="StockStatusToColorConverter"/>
            <converters:StockStatusToBgColorConverter x:Key="StockStatusToBgColorConverter"/>
            <converters:OccupancyColorConverter x:Key="OccupancyColorConverter"/>
            <converters:ZoomToPercentConverter x:Key="ZoomToPercentConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
