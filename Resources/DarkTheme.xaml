<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Backgrounds -->
    <SolidColorBrush x:Key="Theme.Background.Primary" Color="#0B0F19"/>
    <SolidColorBrush x:Key="Theme.Background.Secondary" Color="#111827"/>
    <SolidColorBrush x:Key="Theme.Background.Tertiary" Color="#1E293B"/>

    <!-- Dark Theme Surfaces & Cards -->
    <SolidColorBrush x:Key="Theme.Surface.Card" Color="#151E2E"/>
    <SolidColorBrush x:Key="Theme.Surface.CardAlt" Color="#1A2436"/>
    <SolidColorBrush x:Key="Theme.Surface.Hover" Color="#243147"/>
    <SolidColorBrush x:Key="Theme.Surface.Selected" Color="#2A3852"/>

    <!-- Dark Theme Borders -->
    <SolidColorBrush x:Key="Theme.Border" Color="#2A3852"/>
    <SolidColorBrush x:Key="Theme.Border.Subtle" Color="#1E293B"/>
    <SolidColorBrush x:Key="Theme.Border.Focus" Color="#38BDF8"/>

    <!-- Dark Theme Typography -->
    <SolidColorBrush x:Key="Theme.Text.Primary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Theme.Text.Secondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Theme.Text.Muted" Color="#64748B"/>
    <SolidColorBrush x:Key="Theme.Text.Inverse" Color="#0F172A"/>

    <!-- Dark Navigation & Header -->
    <SolidColorBrush x:Key="Theme.Sidebar.Background" Color="#0F172A"/>
    <SolidColorBrush x:Key="Theme.Sidebar.Border" Color="#1E293B"/>
    <SolidColorBrush x:Key="Theme.Sidebar.ItemHover" Color="#1E293B"/>
    <SolidColorBrush x:Key="Theme.Sidebar.ActiveItem" Color="#1E3A8A"/>

    <SolidColorBrush x:Key="Theme.Header.Background" Color="#0F172A"/>
    <SolidColorBrush x:Key="Theme.Header.Border" Color="#1E293B"/>

    <!-- Dark Warehouse Rack Representation -->
    <SolidColorBrush x:Key="Theme.Rack.SteelFrame" Color="#334155"/>
    <SolidColorBrush x:Key="Theme.Rack.ShelfSurface" Color="#1E293B"/>
    <SolidColorBrush x:Key="Theme.Rack.ShelfBorder" Color="#475569"/>
    <SolidColorBrush x:Key="Theme.Rack.ShelfHover" Color="#2E3C51"/>

    <!-- Inputs & Controls -->
    <SolidColorBrush x:Key="Theme.Input.Background" Color="#111827"/>
    <SolidColorBrush x:Key="Theme.Input.Border" Color="#334155"/>
    <SolidColorBrush x:Key="Theme.Input.FocusBorder" Color="#38BDF8"/>
    <SolidColorBrush x:Key="Theme.Badge.Background" Color="#1E293B"/>
</ResourceDictionary>

